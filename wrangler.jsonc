{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "bus-131",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Google Form response sheet for the A/B mock activity.
    "SHEET_ID": "14q46TtVewBx1bj8qfAlgQUFl0vUpQFaLn3BSzWulS-M",
    "SHEET_GID": "385398337"
  },
  "durable_objects": {
    "bindings": [{ "name": "VOTE", "class_name": "VoteRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoteRoom"] }]
}
